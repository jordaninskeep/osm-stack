        </mxCell>
        <mxCell id="c-cfd" value="&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;profile: public&lt;br&gt;dials out, opens no port" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">

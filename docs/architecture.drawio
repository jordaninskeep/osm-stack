        </mxCell>
        <mxCell id="c-mar" value="&lt;b&gt;Martin&lt;/b&gt;&lt;br&gt;profile: tiles&lt;br&gt;basemap archive + glyphs&lt;br&gt;no database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">

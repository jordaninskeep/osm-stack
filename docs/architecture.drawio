        </mxCell>
        <mxCell id="cli-cf" value="&lt;b&gt;Cloudflare edge&lt;/b&gt;&lt;br&gt;Access SSO on /*&lt;br&gt;Bypass + rate limit on /api/*" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1255" y="300" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cli-team" value="&lt;b&gt;Teammates&lt;/b&gt;&lt;br&gt;basic auth, one credential each" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1255" y="420" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;One datastore.&lt;/b&gt;  Overpass answers every query the map makes:&lt;br&gt;is_in for enclosing areas, nwr(around:) for nearby, nwr[k=v] for&lt;br&gt;search. The basemap is the only other data path and it is prebuilt." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#b3b3b3;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="310" y="600" width="560" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;No inbound ports.&lt;/b&gt;  Caddy joins the tailnet through userspace&lt;br&gt;tsnet; cloudflared dials out. The host firewall drops everything." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#b3b3b3;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="890" y="600" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="Architecture-e1" value="download once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="ext-geo" target="c-pbf">

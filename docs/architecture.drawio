  <diagram id="data-flow" name="Data flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="g1" value="1.  Ingest  -  OSM to Overpass" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1470" height="270" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="2.  Basemap  -  the same extract to tiles" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="1470" height="170" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3.  Read  -  Overpass to a client" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9e9e9e;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="1470" height="400" as="geometry" />
        </mxCell>
        <mxCell id="f-pbf" value="&lt;b&gt;.osm.pbf&lt;/b&gt;&lt;br&gt;regional extract" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8c8c8c;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-conv" value="&lt;b&gt;osmium cat&lt;/b&gt;&lt;br&gt;pbf to bzipped XML,&lt;br&gt;which the image requires" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-init" value="&lt;b&gt;init_osm3s&lt;/b&gt;&lt;br&gt;+ area generation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-db" value="&lt;b&gt;osm3s database&lt;/b&gt;&lt;br&gt;/db/db" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-dif" value="&lt;b&gt;Replication diffs&lt;/b&gt;&lt;br&gt;daily extract  |  planet minutely" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8c8c8c;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="f-clip" value="&lt;b&gt;osmium extract -b&lt;/b&gt;&lt;br&gt;clip to the extract bbox&lt;br&gt;(planet path only)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="195" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-app" value="&lt;b&gt;update_from_dir&lt;/b&gt;&lt;br&gt;every OVERPASS_UPDATE_SLEEP" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="490" y="200" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="f-n1" value="&lt;b&gt;Freshness comes from the source, not the interval.&lt;/b&gt;&lt;br&gt;A daily Geofabrik stream is ~25 h behind however often you poll.&lt;br&gt;Planet minutely is ~1-2 min behind, but is global: unclipped it&lt;br&gt;grows the database toward planet size, and the switch needs the&lt;br&gt;replicate_id reset into planet's sequence space." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#b3b3b3;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="900" y="95" width="590" height="105" as="geometry" />
        </mxCell>
        <mxCell id="f-pbf2" value="&lt;b&gt;.osm.pbf&lt;/b&gt;&lt;br&gt;from the osmdata volume" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#8c8c8c;" vertex="1" parent="1">
          <mxGeometry x="70" y="400" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-pl" value="&lt;b&gt;Planetiler&lt;/b&gt;&lt;br&gt;Protomaps schema, z0-15&lt;br&gt;clipped by CLIP_BBOX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="390" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-pm" value="&lt;b&gt;basemap.pmtiles&lt;/b&gt;&lt;br&gt;tiles volume" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="490" y="400" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-mar" value="&lt;b&gt;Martin&lt;/b&gt;&lt;br&gt;tiles + glyphs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="400" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-n2" value="Manual, not scheduled: the basemap lags the Overpass data&lt;br&gt;until Planetiler is re-run. Purge the Cloudflare cache after,&lt;br&gt;or the edge keeps serving the old tiles." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#b3b3b3;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="900" y="390" width="590" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-c1" value="&lt;b&gt;Map&lt;/b&gt;&lt;br&gt;click a point" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="600" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-c2" value="&lt;b&gt;Map&lt;/b&gt;&lt;br&gt;search by tag" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="680" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-c3" value="&lt;b&gt;QGIS / overpy / curl&lt;/b&gt;&lt;br&gt;existing Overpass tooling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="780" width="150" height="65" as="geometry" />
        </mxCell>
        <mxCell id="f-q1" value="&lt;b&gt;is_in&lt;/b&gt;  -&gt;  out tags bb&lt;br&gt;enclosing areas, extent only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="585" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-q2" value="&lt;b&gt;nwr(around:)&lt;/b&gt;  -&gt;  out geom&lt;br&gt;nodes and ways, 300 cap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="650" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-q3" value="&lt;b&gt;nwr[k=v](bbox)&lt;/b&gt;  -&gt;  out geom&lt;br&gt;union for any, chained for all" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="715" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-q4" value="&lt;b&gt;any Overpass QL&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="270" y="790" width="250" height="45" as="geometry" />
        </mxCell>
        <mxCell id="f-cad" value="&lt;b&gt;Caddy&lt;/b&gt;&lt;br&gt;tailnet: open&lt;br&gt;public: basic auth" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="570" y="640" width="170" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-ovp" value="&lt;b&gt;Overpass&lt;/b&gt;&lt;br&gt;enforces [timeout:] and&lt;br&gt;[maxsize:] per query" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="640" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="f-json" value="&lt;b&gt;OSM JSON&lt;/b&gt;&lt;br&gt;elements[], not GeoJSON" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="600" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f-gj" value="&lt;b&gt;GeoJSON&lt;/b&gt;&lt;br&gt;converted in the browser&lt;br&gt;-&gt; results source, export" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="690" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f-n3" value="&lt;b&gt;Two out-statement traps.&lt;/b&gt;  `out tags geom` suppresses a relation's&lt;br&gt;members, and that is where relation geometry lives - so enclosing&lt;br&gt;areas come back with nothing to draw. And elements are emitted&lt;br&gt;nodes, then ways, then relations, so a low `out` limit truncates&lt;br&gt;before any polygon is reached." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;align=left;spacingLeft=6;fillColor=#ffffff;strokeColor=#b3b3b3;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1020" y="790" width="470" height="105" as="geometry" />
        </mxCell>

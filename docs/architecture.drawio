        </mxCell>
        <mxCell id="c-ovp" value="&lt;b&gt;Overpass API&lt;/b&gt;&lt;br&gt;&lt;br&gt;osm3s database + dispatcher&lt;br&gt;diff updater on its own loop&lt;br&gt;areas built for is_in / area[]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="cli-tail" value="&lt;b&gt;Tailnet devices&lt;/b&gt;&lt;br&gt;map, curl, QGIS, overpy&lt;br&gt;unauthenticated" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">

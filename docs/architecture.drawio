          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Architecture-e12" value="https, MagicDNS cert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#4d4d4d;" edge="1" parent="1" source="c-caddy" target="cli-tail">

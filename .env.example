# osm-stack configuration. Copy to .env and edit; .env is gitignored.
#
#   cp .env.example .env && chmod 600 .env

# ---- The extract --------------------------------------------------------
# Any regional extract from https://download.geofabrik.de/. Both the basemap
# build and the Overpass database are built from this one file, so they always
# describe the same region.
OSM_PBF_URL=https://download.geofabrik.de/north-america/us/ohio-latest.osm.pbf

# Restricts the BASEMAP to a sub-region of the extract; blank means the whole
# thing. Overpass is not clipped by this -- it answers for the full extract.
#   minlon,minlat,maxlon,maxlat
CLIP_BBOX=-84.02,39.16,-82.02,40.72

# ---- Overpass API -------------------------------------------------------
# The query API, and the only live data path in the stack.
#
# OVERPASS_DIFF_URL must match the extract above or updates silently stop.
# For a Geofabrik extract, replace `-latest.osm.pbf` with `-updates/`:
#   https://download.geofabrik.de/north-america/us/ohio-latest.osm.pbf
#   https://download.geofabrik.de/north-america/us/ohio-updates/
# That stream publishes DAILY. For near-live data, point this at OSM's own
# minutely replication instead and clip the diffs -- see docs/DEPLOY.md.
OVERPASS_DIFF_URL=https://download.geofabrik.de/north-america/us/ohio-updates/

# Element version/timestamp/user. The image defaults to "no", which makes
# `out meta;` return nothing.
OVERPASS_META=yes

# Seconds between diff runs. Match it to how often the source publishes:
# 3600 for a daily Geofabrik stream, 60 for planet minutely.
OVERPASS_UPDATE_SLEEP=3600

# Runs against each downloaded change file before it is applied. Leave unset on
# a regional stream. Required on planet minutely, which is global -- applied
# unclipped the database grows toward planet size. Use the extract's own header
# bbox, which is wider than CLIP_BBOX and so leaves fewer broken way references:
#   docker run --rm -v osm_osmdata:/d:ro --entrypoint osmium wiktorn/overpass-api \
#     fileinfo -e -g header.boxes /d/region.osm.pbf
# scripts/switch-to-minutely.sh sets this for you.
#OVERPASS_DIFF_PREPROCESS=osmium extract -b <bbox> -o /db/diffs/clipped.osc /db/diffs/changes.osc && mv -f /db/diffs/clipped.osc /db/diffs/changes.osc

# ---- Basemap build (the `basemap` profile) ------------------------------
#PLANETILER_HEAP=4g
#PLANETILER_ARGS=
#BASEMAPS_REF=a50c699adc60a45c899971b1e11275e61f13bfbf

# ---- Tailnet (Caddy + caddy-tailscale) ----------------------------------
# Caddy joins the tailnet as its own node via userspace tsnet and serves at
# https://$TS_DOMAIN with an automatic cert. No host port is published.
#
# TS_AUTHKEY may be a plain auth key (tskey-auth-...) or an OAuth client
# secret (tskey-client-...). Keys: https://login.tailscale.com/admin/settings/keys
# TS_TAGS is REQUIRED when TS_AUTHKEY is an OAuth client secret, and the tag
# must exist in the tailnet's tagOwners and be in the client's scopes.
TS_AUTHKEY=tskey-client-xxxxxxxxxxxx
TS_HOSTNAME=osm
TS_DOMAIN=osm.your-tailnet.ts.net
TS_TAGS=tag:container

# ---- Local debug port (loopback only; the tailnet path is via Caddy) ----
MARTIN_PORT=127.0.0.1:3003

# ---- Cloudflare Tunnel (optional; the `public` profile) -----------------
# Only needed to expose the stack publicly -- see docs/DEPLOY.md. cloudflared
# runs only under `docker compose --profile public up -d`.
# The token comes from Zero Trust -> Networks -> Tunnels; treat it as a secret.
#CF_TUNNEL_TOKEN=

# ---- Cloudflare Access service token (client credentials) ---------------
# For scripts reaching the stack through the tunnel, which sits behind Access.
# Not needed for /api/*, which is exempted from Access and guarded by the
# per-teammate basic-auth credentials in caddy/auth/.
#CF_ACCESS_CLIENT_ID=
#CF_ACCESS_CLIENT_SECRET=
